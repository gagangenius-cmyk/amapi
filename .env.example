PORT=4000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=aymee
# Required. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# (a "dev-..." value is tolerated for local development only)
JWT_SECRET=dev-replace-this-with-a-long-random-string-0123456789
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=30
# --- production / optional ---
# TRUST_PROXY=1                 # set when behind nginx / a load balancer
# CORS_ORIGIN=https://admin.example.com
# WEBHOOK_SECRET=               # enables POST /ledger/webhook/payment
# --- email (OTP codes) via Nodemailer / SMTP ---
# SMTP_HOST=smtp.gmail.com        # or your provider: Brevo, SendGrid, Amazon SES, Zoho, Mailgun...
# SMTP_PORT=587                   # 587 (STARTTLS) or 465 (with SMTP_SECURE=1)
# SMTP_SECURE=0
# SMTP_USER=you@yourdomain.com
# SMTP_PASS=app-password-or-api-key
# SMTP_FROM=AAYME <no-reply@yourdomain.com>
# OTP_DEV_ECHO=1                # DEV ONLY: returns the OTP in the API response; the server refuses to start with it in production
# MIGRATE_DB_USER=root           # optional: a separate account with DDL rights used only by `npm run migrate`
# MIGRATE_DB_PASSWORD=
